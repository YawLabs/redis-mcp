{
  "name": "@yawlabs/redis-mcp",
  "version": "0.4.2",
  "mcpName": "io.github.YawLabs/redis-mcp",
  "description": "Redis and Valkey MCP server, read-only by default: SCAN key exploration, TTL/memory inspection, slowlog, health, and a DBA advisor.",
  "license": "MIT",
  "author": "YawLabs <contact@yaw.sh>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YawLabs/redis-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/YawLabs/redis-mcp/issues"
  },
  "keywords": [
    "redis",
    "valkey",
    "cache",
    "database",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "agent",
    "claude",
    "claude-code",
    "cursor",
    "llm",
    "scan",
    "slowlog",
    "keyspace",
    "dba",
    "health-check",
    "ai-agents"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "redis-mcp": "bin/redis-mcp.mjs"
  },
  "files": [
    "bin/redis-mcp.mjs",
    "dist/index.js",
    "dist/index.js.map",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node build.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
